    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.9",
    "nodemon": "^3.1.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
